<Window x:Class="StickyNotes.Views.AllNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StickyNotes.ViewModels"
        xmlns:views="clr-namespace:StickyNotes.Views"
        Title="Notas"
        Icon="../Resources/StickyNotes.ico"
        Width="880" Height="620"
        MinWidth="680" MinHeight="460"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WallBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowChrome.WindowChrome="{StaticResource ModernChrome}">

    <Window.Resources>
        <vm:NoteGradientConverter x:Key="NoteGradientConverter"/>
        <vm:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <vm:ArchiveStateConverter x:Key="ArchiveStateConverter"/>
        <vm:ArchiveActionTooltipConverter x:Key="ArchiveActionTooltipConverter"/>
        <vm:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Botões de caption no padrão Win11 -->
        <Style TargetType="Button" x:Key="CaptionButtonStyle">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CaptionCloseButtonStyle" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D70015"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8000F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titlebar: chrome com material -->
        <Grid Grid.Row="0" Height="44" Background="{DynamicResource ChromeFillBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="Notas"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                <TextBlock x:Name="CountText"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Typography.NumeralAlignment="Tabular"
                           IsHitTestVisible="False"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Minimizar"
                        AutomationProperties.Name="Minimizar"
                        Click="OnMinimizeClick">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Maximizar"
                        AutomationProperties.Name="Maximizar"
                        Click="OnMaximizeClick">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CaptionCloseButtonStyle}"
                        ToolTip="Fechar"
                        AutomationProperties.Name="Fechar"
                        Click="OnCloseClick">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                </Button>
            </StackPanel>

            <!-- Fio que separa o chrome do conteúdo -->
            <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource DividerBrush}"/>
        </Grid>

        <!-- Barra de ferramentas. O fundo fica no Grid externo (que cobre a
             linha inteira) e o espaçamento no interno: uma margem junto do
             Background deixaria o vão revelando o fundo da janela. -->
        <Grid Grid.Row="1" Background="{DynamicResource WallBrush}">
            <Grid Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource FieldStyle}"
                    Margin="0,0,12,0"
                    Height="32"
                    VerticalAlignment="Center">
                <Grid Margin="10,0">
                    <TextBlock Text="🔍"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="Buscar por título ou conteúdo"
                               FontSize="12.5"
                               Foreground="{DynamicResource EmptyStateBrush}"
                               VerticalAlignment="Center"
                               Margin="19,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="12.5"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             VerticalContentAlignment="Center"
                             VerticalAlignment="Stretch"
                             Padding="0"
                             AutomationProperties.Name="Buscar notas"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Todas" Style="{StaticResource SegmentedChipStyle}"
                             AutomationProperties.Name="Mostrar todas as notas"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All}"/>
                <RadioButton Content="Ativas" Style="{StaticResource SegmentedChipStyle}"
                             AutomationProperties.Name="Mostrar notas ativas"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Active}"/>
                <RadioButton Content="Arquivadas" Style="{StaticResource SegmentedChipStyle}"
                             AutomationProperties.Name="Mostrar notas arquivadas"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Archived}"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Nova nota" Command="{Binding CreateNoteCommand}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Nova nota"/>
            </Grid>
        </Grid>

        <!-- Parede de notas -->
        <Grid Grid.Row="2" Background="{DynamicResource WallBrush}">
            <ListBox x:Name="NotesWall"
                     ItemsSource="{Binding Notes}"
                     AutomationProperties.Name="Mural de notas"
                     KeyDown="OnWallKeyDown"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10,0,10,10"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Standard"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FocusVisualStyle="{x:Null}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <views:VirtualizingWrapPanel CellWidth="206" CellHeight="206"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Post-it na parede: papel com gradiente, grão, fita e
                             canto dobrado. Elevação só no hover — a parede em
                             repouso fica plana e calma. -->
                        <Border Width="190" Height="190"
                                Margin="8"
                                CornerRadius="3"
                                Loaded="OnStickyLoaded">
                            <Border x:Name="Sticky"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    RenderTransformOrigin="0.5,0.5"
                                    MouseLeftButtonUp="OnStickyClick">
                                <Border.RenderTransform>
                                    <!-- Nomeado para o hover poder animar a escala:
                                         subir de tamanho é barato (GPU), diferente de
                                         um DropShadowEffect, que re-renderiza o cartão
                                         inteiro a cada entrada e saída do mouse. -->
                                    <ScaleTransform x:Name="StickyScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <Binding Path="Color" Converter="{StaticResource NoteGradientConverter}"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Title}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NoteTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="14,16,14,6"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Body}"
                                               FontSize="11.5"
                                               LineHeight="16"
                                               Foreground="{DynamicResource NoteTextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="14,0,14,0"/>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Margin="14,6,14,14">
                                        <TextBlock Text="{Binding IsArchived, Converter={StaticResource ArchiveStateConverter}}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource NoteTextSecondaryBrush}"/>
                                        <TextBlock Text=" · "
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource NoteTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM}}"
                                                   FontSize="10.5"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{DynamicResource NoteTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Fita -->
                                    <Border Width="64" Height="16"
                                            CornerRadius="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,-8,0,0"
                                            Background="{DynamicResource TapeBrush}"
                                            IsHitTestVisible="False"/>

                                    <!-- Canto dobrado -->
                                    <Path Data="M 0,24 L 24,24 L 24,0 Z"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Fill="{DynamicResource FoldShadeBrush}"
                                          IsHitTestVisible="False"/>

                                    <!-- Ações rápidas: só existem quando estão
                                         visíveis. Colapsadas (e não apenas
                                         transparentes) para não virarem paradas
                                         invisíveis de Tab nem serem lidas por
                                         leitor de tela. -->
                                    <Border x:Name="QuickActions"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,8,8,0"
                                            Background="{DynamicResource NoteOverlayBrush}"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="2"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Width="24" Height="22" Padding="0"
                                                    Foreground="{DynamicResource NoteOverlayForegroundBrush}" Cursor="Hand"
                                                    ToolTip="Abrir"
                                                    AutomationProperties.Name="Abrir nota">
                                                <TextBlock Text="✎" FontSize="10.5"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.ArchiveNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Width="24" Height="22" Padding="0"
                                                    Foreground="{DynamicResource NoteOverlayForegroundBrush}" Cursor="Hand"
                                                    ToolTip="{Binding IsArchived, Converter={StaticResource ArchiveActionTooltipConverter}}"
                                                    AutomationProperties.Name="Arquivar nota">
                                                <TextBlock Text="🗂" FontSize="10.5"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Width="24" Height="22" Padding="0"
                                                    Foreground="{DynamicResource NoteOverlayDangerBrush}" Cursor="Hand"
                                                    ToolTip="Excluir"
                                                    AutomationProperties.Name="Excluir nota">
                                                <TextBlock Text="🗑" FontSize="10.5"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StickyScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.03" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="StickyScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.03" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="QuickActions"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.12"
                                                             BeginTime="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StickyScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.11"/>
                                            <DoubleAnimation Storyboard.TargetName="StickyScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.11"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Sticky" Property="BorderBrush"
                                        Value="{DynamicResource FoldShadeBrush}"/>
                                <Setter TargetName="QuickActions" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- Foco de teclado: mesma revelação do hover. O gatilho
                                 olha o ListBoxItem (dono real do foco), não o
                                 ContentPresenter — que é filho dele e não veria
                                 o foco chegar. -->
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin,
                                                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter TargetName="QuickActions" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Sticky" Property="BorderBrush"
                                        Value="{DynamicResource FocusRingBrush}"/>
                                <Setter TargetName="Sticky" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Estado vazio: ensina o espaço e diz o que fazer. Só aparece
                 depois da carga (senão pisca no primeiro frame). -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="🗒"
                           FontSize="30"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"/>
                <TextBlock Text="{Binding EmptyTitle}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyHint}"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
