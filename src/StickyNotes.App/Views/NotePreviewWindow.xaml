<Window x:Class="StickyNotes.Views.NotePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Preview"
        Icon="../Resources/StickyNotes.ico"
        Width="280" Height="200"
        WindowStyle="None"
        Background="#FFE58F"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        TextOptions.TextFormattingMode="Ideal">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Popover de papel: mesmo material da nota, para o preview e a nota
         parecerem o mesmo objeto. -->
    <Border x:Name="PreviewBorder"
            BorderThickness="1"
            Padding="0"
            MouseLeftButtonUp="OnPreviewClick"
            Cursor="Hand"
            ToolTip="Clique para editar">
        <Grid>
            <Border x:Name="GrainLayer" IsHitTestVisible="False"/>

            <Grid Margin="14,13,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           Grid.Row="0"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource NoteTextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,7"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="BodyText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{DynamicResource NoteTextSecondaryBrush}"/>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Text="Clique para editar"
                           FontSize="10.5"
                           Foreground="{DynamicResource NoteTextSecondaryBrush}"
                           Opacity="0.7"
                           HorizontalAlignment="Right"
                           Margin="0,8,0,0"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Fita -->
            <Border x:Name="TapeBorder"
                    Width="64" Height="16"
                    CornerRadius="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,-8,0,0"
                    IsHitTestVisible="False"/>

            <!-- Canto dobrado -->
            <Path x:Name="FoldPath"
                  Data="M 0,20 L 20,20 L 20,0 Z"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
