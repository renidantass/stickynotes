<Window x:Class="StickyNotes.Views.NotePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:StickyNotes.ViewModels"
        Title="Preview"
        Icon="../Resources/StickyNotes.ico"
        Width="280" Height="200"
        WindowStyle="None"
        Background="#FFE866"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="4"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
    </Window.Resources>

    <!-- Nota adesiva: sombra DWM, canto dobrado e "fita" no topo -->
    <Border x:Name="PreviewBorder"
            BorderBrush="#22000000"
            BorderThickness="1"
            Padding="12"
            MouseLeftButtonUp="OnPreviewClick"
            Cursor="Hand"
            ToolTip="Clique para editar">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Fita adesiva -->
                <Border x:Name="TapeBorder"
                        Width="64" Height="16"
                        CornerRadius="2"
                        Background="#66FFFFFF"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,-10,0,0"
                        IsHitTestVisible="False"/>

                <!-- Canto dobrado -->
                <Path x:Name="FoldPath"
                      Data="M 0,0 L 14,0 L 0,14 Z"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False"/>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="TitleText"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource NoteTextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <TextBox x:Name="BodyText"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Foreground="{DynamicResource NoteTextPrimaryBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="1"
                           Text="Clique para editar"
                           FontSize="10"
                           Foreground="{DynamicResource NoteTextSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,16,2"
                           IsHitTestVisible="False"/>
            </Grid>
    </Border>
</Window>
