<Window x:Class="StickyNotes.Views.DeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:StickyNotes.ViewModels"
        Title="StickyNotes"
        Icon="../Resources/StickyNotes.ico"
        WindowStyle="None"
        Background="{DynamicResource DeckBackgroundBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        KeyDown="OnDeckKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <vm:NoteGradientConverter x:Key="NoteGradientConverter"/>
    </Window.Resources>

    <Border x:Name="DeckBorder"
            Background="{DynamicResource DeckBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{DynamicResource DeckBorderBrush}"
            BorderThickness="1"
            Padding="2"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave">

        <Grid>
            <!-- Estado compacto: pilha de fatias coloridas (uma por nota) + badge -->
            <Grid>
                <Button x:Name="ExpandButton"
                        Style="{StaticResource DeckPillButtonStyle}"
                        ToolTip="Criar primeira nota"
                        Click="OnExpandClick">
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="1,0.5"
                                        CornerRadius="3">
                                    <Border.Background>
                                        <Binding Path="Color" Converter="{StaticResource NoteGradientConverter}"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Button>

                <!-- Estado vazio (pill): ícone de nova nota — clique cria a primeira nota -->
                <TextBlock x:Name="EmptyIndicator"
                           Text="✎"
                           FontSize="12"
                           Foreground="#BBBBBB"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

                <!-- Badge com o número de notas -->
                <Border x:Name="NoteCountBadge"
                        Background="{DynamicResource BadgeBackgroundBrush}"
                        CornerRadius="7"
                        Padding="0"
                        Width="16" Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,4"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding NoteCount}"
                               Foreground="{DynamicResource BadgeForegroundBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Estado expandido: abas verticais com gradiente (mesma linguagem da pill) -->
            <StackPanel x:Name="MenuPanel"
                        Visibility="Collapsed"
                        Margin="3,6,3,12"
                        HorizontalAlignment="Center">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="460"
                              VerticalAlignment="Top"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="NotesItemsControl" ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Aba vertical: gradiente da nota + título rotacionado -->
                                <Button x:Name="TabButton"
                                        Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource NoteTabStyle}"
                                        Margin="0,3"
                                        HorizontalContentAlignment="Center"
                                        ToolTip="{Binding Title}"
                                        MouseEnter="OnNoteTabMouseEnter"
                                        MouseLeave="OnNoteTabMouseLeave">
                                    <Border Width="52"
                                            MinHeight="58"
                                            CornerRadius="8"
                                            Margin="0">
                                        <Border.Background>
                                            <Binding Path="Color" Converter="{StaticResource NoteGradientConverter}"/>
                                        </Border.Background>
                                        <Grid>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource NoteTextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5"
                                                       MaxWidth="180"
                                                       MaxHeight="160">
                                                <TextBlock.LayoutTransform>
                                                    <RotateTransform Angle="-90"/>
                                                </TextBlock.LayoutTransform>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Command="{Binding CreateNoteCommand}"
                        Style="{StaticResource DeckActionButtonStyle}"
                        Width="52" MinHeight="34"
                        Margin="0,8,0,0"
                        ToolTip="Nova nota">
                    <TextBlock Text="+"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <Button Command="{Binding OpenAllNotesCommand}"
                        Style="{StaticResource DeckActionButtonStyle}"
                        Width="52" MinHeight="34"
                        Margin="0,3,0,0"
                        ToolTip="Todas as notas">
                    <TextBlock Text="▤"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <Button Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource DeckActionButtonStyle}"
                        Width="52" MinHeight="34"
                        Margin="0,3,0,0"
                        ToolTip="Configurações">
                    <TextBlock Text="⚙"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <Button Command="{Binding ExitCommand}"
                        Style="{StaticResource DeckActionButtonStyle}"
                        Width="52" MinHeight="34"
                        Margin="0,8,0,0"
                        ToolTip="Sair do StickyNotes">
                    <TextBlock Text="✕"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
