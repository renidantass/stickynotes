<Window x:Class="StickyNotes.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StickyNotes.ViewModels"
        Title="Configurações"
        Icon="../Resources/StickyNotes.ico"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WallBrush}"
        ResizeMode="NoResize"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowChrome.WindowChrome="{StaticResource ModernChrome}"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <vm:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: chrome com material -->
        <Border Grid.Row="0"
                Background="{DynamicResource ChromeFillBrush}"
                Padding="20,15"
                CornerRadius="12,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Configurações"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding AppVersion}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16,20,18">

            <!-- Um cartão por grupo de consequência, com fios entre as linhas -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Margin="18,16,18,16">
                        <TextBlock Text="TEMA" Style="{StaticResource TextSectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Content="Sistema" Style="{StaticResource SegmentedChipStyle}"
                                         AutomationProperties.Name="Tema do sistema"
                                         IsChecked="{Binding ThemeSystem}"/>
                            <RadioButton Content="Claro" Style="{StaticResource SegmentedChipStyle}"
                                         AutomationProperties.Name="Tema claro"
                                         IsChecked="{Binding ThemeLight}"/>
                            <RadioButton Content="Escuro" Style="{StaticResource SegmentedChipStyle}"
                                         AutomationProperties.Name="Tema escuro"
                                         IsChecked="{Binding ThemeDark}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                    <StackPanel Margin="18,16,18,16">
                        <TextBlock Text="DECK NA BORDA" Style="{StaticResource TextSectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Content="Esquerda" Style="{StaticResource SegmentedChipStyle}"
                                         AutomationProperties.Name="Deck na esquerda"
                                         IsChecked="{Binding DockSideLeft}"/>
                            <RadioButton Content="Direita" Style="{StaticResource SegmentedChipStyle}"
                                         AutomationProperties.Name="Deck na direita"
                                         IsChecked="{Binding DockSideRight}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasMultipleMonitors, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Height="1" Background="{DynamicResource DividerBrush}"/>
                        <StackPanel Margin="18,16,18,16">
                            <TextBlock Text="MONITOR DO DECK" Style="{StaticResource TextSectionLabel}"/>
                            <ComboBox ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding SelectedMonitor}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Left"
                                      MinWidth="240"
                                      Margin="0,10,0,0"
                                      AutomationProperties.Name="Monitor do deck"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                    <Grid Margin="18,15,18,15">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="INICIALIZAÇÃO" Style="{StaticResource TextSectionLabel}"/>
                            <TextBlock Text="Abre junto com o Windows"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding StartWithWindows}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Iniciar com o Windows"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Fechar" Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick"/>
                <Button Content="Salvar" Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        Click="OnSaveClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
