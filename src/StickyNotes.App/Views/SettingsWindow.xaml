<Window x:Class="StickyNotes.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:StickyNotes.ViewModels"
        Title="Configurações"
        Icon="../Resources/StickyNotes.ico"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WallBrush}"
        ResizeMode="NoResize"
        Topmost="True"
        KeyDown="OnKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button" x:Key="SettingsButtonStyle" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- Chip de opção (mesmo visual dos filtros do mural) -->
        <Style TargetType="RadioButton" x:Key="OptionChipStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ControlStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WallBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="Configurações"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,18,20,20">
            <!-- Tema -->
            <TextBlock Text="Tema"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <RadioButton Content="Sistema" Style="{StaticResource OptionChipStyle}"
                             IsChecked="{Binding ThemeSystem}"/>
                <RadioButton Content="Claro" Style="{StaticResource OptionChipStyle}"
                             IsChecked="{Binding ThemeLight}"/>
                <RadioButton Content="Escuro" Style="{StaticResource OptionChipStyle}"
                             IsChecked="{Binding ThemeDark}"/>
            </StackPanel>

            <!-- Lado do deck -->
            <TextBlock Text="Deck na borda"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <RadioButton Content="Esquerda" Style="{StaticResource OptionChipStyle}"
                             IsChecked="{Binding DockSideLeft}"/>
                <RadioButton Content="Direita" Style="{StaticResource OptionChipStyle}"
                             IsChecked="{Binding DockSideRight}"/>
            </StackPanel>

            <!-- Iniciar com o Windows -->
            <CheckBox Content="Iniciar com o Windows"
                      IsChecked="{Binding StartWithWindows}"
                      FontSize="12.5"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      VerticalAlignment="Center"
                      Margin="0,0,0,18"/>

            <!-- Ações -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fechar" Style="{StaticResource SettingsButtonStyle}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick"/>
                <Button Content="Salvar" Style="{StaticResource SettingsButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource TextOnAccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        IsDefault="True"
                        Click="OnSaveClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
