<Window x:Class="StickyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title}"
        Icon="../Resources/StickyNotes.ico"
        Width="340" Height="420"
        MinWidth="260" MinHeight="220"
        WindowStyle="None"
        Background="#FFE58F"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        ShowActivated="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        KeyDown="OnKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Fechar: o único botão que fica vermelho no hover -->
        <Style TargetType="Button" x:Key="CloseButtonStyle" BasedOn="{StaticResource NoteIconButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="{StaticResource RadiusSM}"/>
                            <Border x:Name="Ring" CornerRadius="{StaticResource RadiusSM}"
                                    BorderBrush="#8A1F1F1F" BorderThickness="2" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D70015"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8000F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A nota é conteúdo, não chrome: papel opaco, nunca material translúcido.
         O volume vem do gradiente de papel; o grão e o canto dobrado dão o
         resto da leitura de "folha". -->
    <Border x:Name="NoteBorder"
            BorderBrush="#26000000"
            BorderThickness="1">
        <Grid>
            <!-- Textura de papel (extremamente sutil, não interativa) -->
            <Border x:Name="GrainLayer" IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superior: arrastar + título + ações -->
                <Grid Grid.Row="0" Margin="14,11,8,6"
                      MouseLeftButtonDown="OnTitleBarMouseDown"
                      Cursor="SizeAll"
                      ToolTip="Arraste para mover">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TitleBox"
                             Grid.Column="0"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource NoteTextPrimaryBrush}"
                             VerticalContentAlignment="Center"
                             Padding="0,2,4,2"
                             AutomationProperties.Name="Título da nota"
                             TextChanged="OnContentChanged"/>

                    <TextBlock Grid.Column="1"
                               x:Name="SavedIndicator"
                               Text="✓"
                               FontSize="12"
                               Foreground="#3F6B25"
                               VerticalAlignment="Center"
                               Margin="2,0,4,0"
                               ToolTip="Salvo"
                               Visibility="Collapsed"/>

                    <!-- Ações sempre visíveis (nunca só no hover): ficam
                         discretas pelo peso, não pela ausência. -->
                    <Button Grid.Column="2" Style="{StaticResource NoteIconButtonStyle}"
                            ToolTip="Cor (Ctrl+.)"
                            AutomationProperties.Name="Mudar cor da nota"
                            Click="OnColorClick">
                        <TextBlock Text="◐" FontSize="13"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource NoteIconButtonStyle}"
                            ToolTip="Arquivar"
                            AutomationProperties.Name="Arquivar nota"
                            Click="OnArchiveClick">
                        <TextBlock Text="🗂" FontSize="12"/>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource NoteIconButtonStyle}"
                            ToolTip="Excluir (Ctrl+Del)"
                            AutomationProperties.Name="Excluir nota"
                            Click="OnDeleteClick">
                        <TextBlock Text="🗑" FontSize="12"/>
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource CloseButtonStyle}"
                            ToolTip="Fechar (Esc)"
                            AutomationProperties.Name="Fechar nota"
                            Click="OnCloseClick">
                        <TextBlock Text="✕" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                </Grid>

                <!-- Corpo: entrelinha aberta para leitura confortável -->
                <TextBox x:Name="BodyBox"
                         Grid.Row="1"
                         Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         FontSize="13"
                         Foreground="{DynamicResource NoteTextSecondaryBrush}"
                         Padding="14,2,14,18"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Conteúdo da nota"
                         TextChanged="OnContentChanged"/>
            </Grid>

            <!-- Canto dobrado: o detalhe que diz "papel" e não "retângulo" -->
            <Path Data="M 0,20 L 20,20 L 20,0 Z"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Fill="{DynamicResource FoldShadeBrush}"
                  IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
