<Window x:Class="StickyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:StickyNotes.ViewModels"
        Title="{Binding Title}"
        Icon="../Resources/StickyNotes.ico"
        Width="340" Height="420"
        MinWidth="260" MinHeight="220"
        WindowStyle="None"
        Background="#FFE866"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        ShowActivated="True"
        KeyDown="OnKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Botão de fechar com hover vermelho (sobre o post-it claro) -->
        <Style TargetType="Button" x:Key="CloseButtonStyle" BasedOn="{StaticResource NoteIconButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B03A24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="NoteBorder"
            BorderBrush="#33000000"
            BorderThickness="1"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior: arrastar + título + ações -->
            <Grid Grid.Row="0" Margin="10,8,6,4"
                  MouseLeftButtonDown="OnTitleBarMouseDown"
                  Cursor="SizeAll"
                  ToolTip="Arraste para mover">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TitleBox"
                         Grid.Column="0"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{DynamicResource NoteTextPrimaryBrush}"
                         VerticalContentAlignment="Center"
                         Padding="2,2"
                         TextChanged="OnContentChanged"/>

                <TextBlock Grid.Column="1"
                           x:Name="SavedIndicator"
                           Text="✓"
                           FontSize="12"
                           Foreground="#4A7A2E"
                           VerticalAlignment="Center"
                           Margin="4,0,4,0"
                           ToolTip="Salvo"
                           Visibility="Collapsed"/>

                <Button Grid.Column="2" Style="{StaticResource NoteIconButtonStyle}"
                        ToolTip="Cor (Ctrl+.)"
                        Click="OnColorClick">
                    <TextBlock Text="◐" FontSize="14"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource NoteIconButtonStyle}"
                        ToolTip="Arquivar"
                        Click="OnArchiveClick">
                    <TextBlock Text="🗂" FontSize="13"/>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource NoteIconButtonStyle}"
                        ToolTip="Excluir (Ctrl+Del)"
                        Click="OnDeleteClick">
                    <TextBlock Text="🗑" FontSize="13"/>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource CloseButtonStyle}"
                        ToolTip="Fechar (Esc)"
                        Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Corpo -->
            <TextBox x:Name="BodyBox"
                     Grid.Row="1"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{DynamicResource NoteTextPrimaryBrush}"
                     Padding="12,4,10,12"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="OnContentChanged"/>
        </Grid>
    </Border>
</Window>
